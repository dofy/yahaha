---
import '@/styles/globals.css'
import keywords from '@/data/keywords.json'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Logo from '@/components/Logo.astro'
import ThemeToggle from '@/components/islands/ThemeToggle'
import { pageMetadata, canonicalPath } from '@/lib/site'

interface Props {
  title?: string
  wide?: boolean
}

const { title, wide = false } = Astro.props

const suffix = 'Seven'
const fullTitle = title ? `${title} - ${suffix}` : suffix
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'
const containerClass =
  pathname === '/'
    ? 'container-home'
    : wide
      ? 'container-wide'
      : 'container-page'
const metadata = pageMetadata[pathname] ?? pageMetadata['/']
const canonical = new URL(
  canonicalPath(pathname),
  Astro.site ?? 'https://yahaha.net'
)
const image = new URL('/logo.png', canonical)
---

<!doctype html>
<html lang={metadata.lang}>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title data-page-title={title ?? ''}>{fullTitle}</title>
    <link rel='icon' href='/favicon.ico' />
    <link rel='apple-touch-icon' href='/logo.png' />
    <link rel='manifest' href='/manifest.json' />
    <meta name='description' content={metadata.description} />
    <meta name='keywords' content={keywords.join()} />
    <link rel='canonical' href={canonical.href} />
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonical.href} />
    <meta property='og:description' content={metadata.description} />
    <meta property='og:image' content={image.href} />
    <meta property='og:title' content={title ?? suffix} />
    <meta property='og:site_name' content={suffix} />
    <!--
      Three tags on purpose. The two media-scoped ones key off the OS
      preference, so they are only correct while the toggle is on `auto`; they
      stay as the pre-JS fallback. The unconditional one is rewritten by the
      script below and by ThemeToggle, so it tracks a manual override too.
    -->
    <meta name='theme-color' content='#fffdfc' data-theme-color />
    <meta
      name='theme-color'
      content='#fffdfc'
      media='(prefers-color-scheme: light)'
    />
    <meta
      name='theme-color'
      content='#1b1a18'
      media='(prefers-color-scheme: dark)'
    />
    <meta name='twitter:card' content='summary' />
    <meta name='twitter:title' content={title ?? suffix} />
    <meta name='twitter:description' content={metadata.description} />
    <meta name='twitter:image' content={image.href} />
    <meta name='twitter:creator' content='@dofy' />
    <meta name='twitter:site' content='@dofy' />
    <meta name='generator' content={Astro.generator} />
    <!-- Set theme before paint to avoid FOUC -->
    <script is:inline>
      ;(() => {
        let stored = null
        try {
          stored = localStorage.getItem('theme')
        } catch {
          /* Storage may be disabled. */
        }
        const prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)'
        ).matches
        const dark = stored === 'dark' || (stored !== 'light' && prefersDark)
        if (dark) {
          document.documentElement.classList.add('dark')
        }
        // Keep the unconditional theme-color tag in step with the class, since
        // the media-scoped tags cannot see a manual override.
        const tag = document.querySelector('meta[data-theme-color]')
        if (tag) tag.setAttribute('content', dark ? '#1b1a18' : '#fffdfc')
      })()
    </script>
  </head>
  <body>
    <Header>
      <ThemeToggle client:load />
    </Header>
    <div class={containerClass}>
      <main id='main' tabindex='-1' class='animate-fade-in'>
        {pathname !== '/' && (
          <nav aria-label='Main navigation' class='mb-6'>
            <a href='/' class='link text-sm'>
              ← Home
            </a>
          </nav>
        )}
        <slot />
        <Logo />
      </main>
    </div>
    <Footer />
    <script>
      import { siteIdentity } from '@/lib/identity'

      const { name, domain } = siteIdentity(window.location.hostname)
      document
        .querySelectorAll<HTMLAnchorElement>('[data-site-brand]')
        .forEach((brand) => {
          const label = brand.querySelector('[data-site-name]')
          if (label) label.textContent = name
          brand.setAttribute('aria-label', `${name} home`)
        })
      document
        .querySelectorAll<HTMLAnchorElement>('[data-domain]')
        .forEach((link) => {
          if (link.dataset.domain === domain) {
            link.setAttribute('aria-current', 'page')
          }
        })
      const pageTitle = document.querySelector('title')?.dataset.pageTitle
      document.title = pageTitle ? `${pageTitle} - ${name}` : name
    </script>
  </body>
</html>
