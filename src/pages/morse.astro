---
import Base from '@/layouts/Base.astro'
import MorseCode from '@/components/islands/MorseCode'
---

<Base title='Morse Code'>
  <header class='animate-fade-in-up'>
    <h1 class='page-title'>Morse Code</h1>
    <p class='page-subtitle'>
      Convert text to morse code or decode morse back to text. Click the result
