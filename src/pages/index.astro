---
import '@fontsource-variable/manrope'
import '@fontsource-variable/jetbrains-mono'
import '@fontsource/cormorant-garamond/500-italic.css'
import '@fontsource/cormorant-garamond/600-italic.css'
import keywords from '@/data/keywords.json'
import site from '@/data/map.json'
import { pageMetadata, canonicalPath } from '@/lib/site'
import { version } from '../../package.json'
import daylight from '@/scripts/daylight.js?raw'

// The homepage is a full-screen 3D map (src/scripts/map-engine.js + src/data/map.json), so it
// does not use Base: no header, footer or container, only the shared metadata.
const metadata = pageMetadata['/']
const canonical = new URL(canonicalPath('/'), Astro.site ?? 'https://yahaha.net')
const image = new URL('/logo.png', canonical)
// Static link list for browsers without JavaScript, from the same map data.
const pick = (v: string | Record<string, string>) => (typeof v === 'string' ? v : v.en ?? Object.values(v)[0])
const fallback = site.cities.map((c) => ({
  title: pick(c.role as string | Record<string, string>),
  items: c.items.map((it) => ({ name: pick(it.name as string | Record<string, string>), url: it.url }))
}))
---

<!doctype html>
<html lang={metadata.lang}>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0, viewport-fit=cover' />
    <title>Seven</title>
    <link rel='icon' href='/favicon.ico' />
    <link rel='apple-touch-icon' href='/logo.png' />
    <link rel='manifest' href='/manifest.json' />
    <meta name='description' content={metadata.description} />
    <meta name='keywords' content={keywords.join()} />
    <link rel='canonical' href={canonical.href} />
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonical.href} />
    <meta property='og:description' content={metadata.description} />
    <meta property='og:image' content={image.href} />
    <meta property='og:title' content='Seven' />
    <meta property='og:site_name' content='Seven' />
    <meta name='theme-color' content='#f1eadb' />
    <meta name='twitter:card' content='summary' />
    <meta name='twitter:title' content='Seven' />
    <meta name='twitter:description' content={metadata.description} />
    <meta name='twitter:image' content={image.href} />
    <meta name='twitter:creator' content='@dofy' />
    <meta name='twitter:site' content='@dofy' />
    <meta name='generator' content={Astro.generator} />
    <!-- time-of-day colours before first paint, so the loader is not white at night -->
    <script is:inline set:html={daylight} />
    <noscript><style is:inline>.loader { display: none; }</style></noscript>
  </head>
  <body>
<div class="map intro" id="map" data-version={version}>
      <div class="loader" id="loader" role="status" aria-live="polite">
        <div class="ld-paper" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="ld-title" id="ld-title">正在折一片中洲</div>
        <div class="ld-step" id="ld-step">准备纸张…</div>
        <div class="ld-bar"><i id="ld-bar"></i></div>
      </div>
      <div class="labels" id="labels"></div>
      <header class="ui brand"><h1 class="site-h1"><a class="site" id="site" href="/">yahaha.net</a></h1><nav class="links" id="site-links" aria-label="Links"></nav></header>
      <nav class="ui crumb" id="crumb" aria-label="位置"></nav>
      <div class="map-controls">
      <div class="ui compass" aria-hidden="true">
        <svg viewBox="-17 -17 34 34"><circle r="15" fill="none" stroke="currentColor"/><circle r="11.5" fill="none" stroke="currentColor" stroke-dasharray="1 2.2" opacity=".6"/><g id="needle"><path d="M0 -13 L3.4 0 L0 2 L-3.4 0Z" fill="var(--coral)" stroke="currentColor"/><path d="M0 13 L3.4 0 L-3.4 0Z" fill="none" stroke="currentColor"/></g></svg>
      </div>
      <div class="ui tools" role="toolbar" aria-label="视角">
        <button type="button" id="b-home"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4.5 6 3l4 1.5 4-1.5v8.5L10 13l-4-1.5L2 13zM6 3v8.5M10 4.5V13" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="t">全图</span></button>
        <button type="button" id="b-cities" aria-haspopup="menu" aria-controls="city-menu" aria-expanded="false" aria-label="Cities"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 13.5h11M3.5 13V7h4v6M8.5 13V3h4v10M5 8.7h1M10 5h1M10 7.2h1M10 9.4h1" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="t">Cities</span></button>
        <button type="button" id="b-tour" aria-pressed="false"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 13.5c-.2-3 4.2-2.6 4.2-5.6S3.6 4.3 5 2.6M10 2.5v6.5M10 2.5h3.6l-1 1.6 1 1.6H10M2.5 13.5h2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="t">导览</span></button>
        <button type="button" id="b-spin" aria-pressed="false"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.2 8.6A5.2 5.2 0 1 1 11.6 4.3M11.9 1.6v3h-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="t">环绕</span></button>
        <button type="button" id="b-top" aria-pressed="false"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5v5M5.8 4.5 8 6.7l2.2-2.2M2.2 10.6 8 7.6l5.8 3L8 13.7z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="t">俯视</span></button>
        <span class="sep" aria-hidden="true"></span>
        <button type="button" id="b-lang" lang="en"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2zM2 8h12M8 2c1.9 2.1 1.9 9.9 0 12M8 2c-1.9 2.1-1.9 9.9 0 12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="t">EN</span></button>
        <button type="button" id="b-keys" aria-haspopup="dialog" aria-controls="keys">?</button>
      </div>
      </div>
      <footer class="ui foot">
        <nav class="domains" aria-label="Domains">
          {site.site.domains.map((domain) => <a href={`https://${domain.toLowerCase()}`}>{domain}</a>)}
        </nav>
        <div class="foot-meta"><span class="clock" id="clock"></span><span class="copy">&copy; 2007&ndash;<span id="year">2026</span> Seven</span><a class="ver" id="version" href={`https://github.com/dofy/yahaha/releases/tag/v${version}`}>v{version}</a></div>
      </footer>
      <div class="ui keys" id="keys" role="dialog" aria-modal="false" aria-labelledby="keys-title" hidden><h2 id="keys-title">Keyboard shortcuts</h2><dl id="keys-list"></dl><p id="keys-close"></p></div>
      <aside class="ui info" id="info" aria-label="说明">
        <div class="info-head"><span class="eyebrow" id="info-eyebrow">yahaha.net</span><button type="button" class="fold" id="fold" aria-expanded="true" aria-controls="panel">收起</button></div>
        <div class="panel" id="panel" aria-live="polite"></div>
        <div class="hint" id="hint"></div>
        <div class="mobile-bubble" id="mobile-bubble" aria-live="polite"></div>
      </aside>
    </div>
    <noscript>
      <nav class='no-js' aria-label='All links'>
        {fallback.map((group) => (
          <section>
            <h2>{group.title}</h2>
            <ul>
              {group.items.map((item) => (
                <li><a href={item.url}>{item.name}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </nav>
    </noscript>
    <script>
      import { mountMap } from '@/scripts/map-engine.js'
      import site from '@/data/map.json'

      const host = location.hostname.toLowerCase().replace(/^www\./, '')
      document.querySelectorAll<HTMLAnchorElement>('.domains a').forEach((link) => {
        if (new URL(link.href).hostname === host) link.setAttribute('aria-current', 'page')
      })
      mountMap(site)
    </script>
  </body>
</html>

<style is:global>

/* Layout: the map is the whole page — a folded-paper continent (three.js) with ink creases from a
   normal+depth edge pass. Cities = categories, buildings = tools. All text lives in one corner info box. */
:root {
  --sky: #f1eadb;
  --card: #fffdf8;
  --paper: #fbf7ee;
  --road: #eee2c6;
  --kraft: #c59c6c;
  --kraft-deep: #946b43;
  --stone: #b9b3a7;
  --slate: #8d99a2;
  --snow: #fdfcf7;
  --grass: #bcc58c;
  --meadow: #d6cf8e;
  --olive: #7c8b48;
  --pine: #566a3f;
  --mustard: #e0a22b;
  --terra: #c56a42;
  --roof-slate: #6f8598;
  --wall-rose: #ecd0bf;
  --wall-sage: #d7dfc4;
  --wall-sky: #d2e0e3;
  --water: #9fbcc3;
  --water-ink: #5a7d86;
  --ink: #3a2f25;
  --ink-soft: #5b5046;
  --ink-faint: #7d7266;
  --line: #e2d8c8;
  --coral: #ff6554;
  --coral-deep: #b83d30;
  --coral-wash: #ffd9cf;
  --ui-card: #fffdf8; --ui-ink: #3a2f25; --ui-soft: #5b5046; --ui-faint: #7d7266; --ui-line: #e2d8c8; --ui-hot: #ffd9cf; --ui-water: #5a7d86; --ui-shadow: rgba(58, 47, 37, .16);
  --font-sans: 'Manrope Variable', 'PingFang SC', 'Hiragino Sans GB', system-ui, sans-serif;
  --font-map: 'Cormorant Garamond', 'Songti SC', 'STSong', Georgia, serif;
  --font-mono: 'JetBrains Mono Variable', 'SFMono-Regular', Consolas, 'PingFang SC', monospace;
}

* { box-sizing: border-box; }
html, body { height: 100%; }
body { transition: background-color .8s; background: var(--sky); color: var(--ui-ink); font-family: var(--font-sans); font-size: 15px; line-height: 1.55; overflow: hidden; }

.map { position: fixed; inset: 0; overflow: hidden; background: var(--sky); user-select: none; -webkit-user-select: none; }
.map canvas { display: block; width: 100%; height: 100%; cursor: grab; touch-action: none; }
.map canvas:active { cursor: grabbing; }
.map.pointing canvas { cursor: pointer; }
.map.panning canvas { cursor: move; }
.labels { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
.ui { z-index: 2; }

.ui { position: absolute; display: flex; gap: 6px; align-items: center; }
.map-controls { display: contents; }
.brand { top: calc(14px + env(safe-area-inset-top, 0px)); left: calc(14px + env(safe-area-inset-left, 0px)); gap: 0;
  background: var(--ui-card); border: 1px solid var(--ui-ink); border-radius: 999px; padding: 3px; }
.brand a { color: var(--ui-ink); text-decoration: none; border-radius: 999px; padding: 4px 12px; }
.brand .site { font-family: var(--font-map); font-style: italic; font-weight: 600; font-size: 18px; line-height: 1.1; }
.brand a:hover { background: var(--ui-line); }
.brand .links { display: flex; align-items: center; }
.brand .links:empty { display: none; }
.brand .links a { display: inline-flex; align-items: center; gap: 5px; font-family: var(--font-mono); font-size: 11.5px; color: var(--ui-soft);
  border-left: 1px solid var(--ui-line); border-radius: 0; padding: 4px 10px; }
.brand .links a:last-child { border-radius: 0 999px 999px 0; }
.brand .links .ic { width: 14px; height: 14px; flex: none; }
.brand .links img.ic { object-fit: contain; }
.brand .links .ext { width: 11px; height: 11px; opacity: .6; transition: transform .2s, opacity .2s; }
.brand .links a:hover .ext { opacity: 1; transform: translate(1px, -1px); }
@media (max-width: 760px) { .brand .links a:has(.ic) .t { display: none; } .brand .links a { padding: 4px 9px; } }
.tools .sep { width: 1px; height: 16px; background: var(--ui-line); margin: 0 2px; }
.foot { left: calc(76px + env(safe-area-inset-left, 0px)); bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  font-family: var(--font-mono); font-size: 11px; color: var(--ui-soft);
  background: color-mix(in srgb, var(--ui-card) 88%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border: 1.5px solid var(--ui-ink); border-radius: 14px; padding: 6px 12px; }
.lang-en .place small { display: none; }
.keys { left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(380px, calc(100vw - 32px)); flex-direction: column; align-items: stretch; gap: 10px;
  background: var(--ui-card); color: var(--ui-ink); border: 1.5px solid var(--ui-ink); border-radius: 14px; padding: 18px 20px; box-shadow: 0 18px 50px var(--ui-shadow); z-index: 4; }
[hidden] { display: none !important; }
.keys h2 { margin: 0; font-family: var(--font-map); font-style: italic; font-weight: 600; font-size: 24px; }
.keys dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 7px 14px; align-items: baseline; }
.keys dt { display: flex; gap: 4px; justify-content: flex-end; }
.keys .or { color: var(--ui-faint); font-family: var(--font-mono); font-size: 11px; align-self: center; }
.keys dd { margin: 0; color: var(--ui-soft); font-size: 14px; }
.keys kbd, .hint kbd { font-family: var(--font-mono); font-size: 11px; min-width: 22px; text-align: center; padding: 2px 6px; border: 1px solid var(--ui-ink);
  border-bottom-width: 2px; border-radius: 5px; background: var(--ui-card); color: var(--ui-ink); }
.keys p { margin: 0; font-family: var(--font-mono); font-size: 11px; color: var(--ui-faint); }
.foot { flex-direction: column; align-items: flex-start; gap: 4px; }
.foot-meta { display: flex; align-items: center; gap: 10px; color: var(--ui-faint); }
.domains { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: 12px; }
.domains a { color: var(--ui-ink); text-decoration: none; }
.domains a:hover, .domains a:focus-visible { color: var(--ui-ink); text-decoration: underline; }
.domains a[aria-current="page"] { color: var(--ui-ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--coral); text-underline-offset: 3px; }
.clock { color: var(--ui-ink); font-weight: 600; }
.clock::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; background: var(--sun, var(--mustard)); vertical-align: 0; border: 1px solid var(--ui-ink); }
.crumb { top: calc(60px + env(safe-area-inset-top, 0px)); left: calc(14px + env(safe-area-inset-left, 0px));
  font-family: var(--font-mono); font-size: 12px; background: var(--ui-card); border: 1px solid var(--ui-ink); border-radius: 999px; padding: 4px 6px; }
.crumb button, .tools button { font: inherit; color: inherit; background: none; border: 0; padding: 3px 9px; border-radius: 999px; cursor: pointer; }
.crumb button:hover, .tools button:hover { background: var(--ui-line); }
.crumb .here { padding: 2px 8px; font-weight: 600; }
.crumb .sep { color: var(--ui-faint); }
.tools { top: calc(14px + env(safe-area-inset-top, 0px)); right: calc(14px + env(safe-area-inset-right, 0px));
  font-family: var(--font-mono); font-size: 12px; background: var(--ui-card); border: 1px solid var(--ui-ink); border-radius: 999px; padding: 4px; }
.tools button[aria-pressed="true"] { background: var(--ui-hot); }
.compass { left: calc(14px + env(safe-area-inset-left, 0px)); bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  background: var(--ui-card); border: 1px solid var(--ui-ink); border-radius: 999px; padding: 4px; color: var(--ui-ink); }
.compass svg { width: 40px; height: 40px; display: block; }

.info { right: calc(14px + env(safe-area-inset-right, 0px)); bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  width: min(340px, calc(100vw - 28px)); max-height: calc(100% - 96px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));
  flex-direction: column; align-items: stretch; gap: 0;
  background: color-mix(in srgb, var(--ui-card) 88%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border: 1.5px solid var(--ui-ink); border-radius: 14px; box-shadow: 0 18px 50px var(--ui-shadow); }
.mobile-bubble { display: none; }
.info-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 10px 0 16px; }
.fold { font-family: var(--font-mono); font-size: 11px; color: var(--ui-soft); background: none; border: 1px solid var(--ui-line);
  border-radius: 999px; padding: 2px 10px; cursor: pointer; }
.fold:hover { border-color: var(--ui-ink); }
.info .panel { padding: 8px 16px 14px; overflow-y: auto; overscroll-behavior: contain; }
.info .hint { padding: 8px 16px 10px; border-top: 1px solid var(--ui-line); font-family: var(--font-mono); font-size: 11px; color: var(--ui-faint); }
.info.folded .panel, .info.folded .hint { display: none; }
.info.folding { overflow: hidden; transition: height .38s cubic-bezier(.2, .8, .2, 1), opacity .7s, transform .8s; }
.info.folding .panel, .info.folding .hint { transition: opacity .25s; }
.info.folding.folded .panel, .info.folding.folded .hint { opacity: 0; }
.info.folded .info-head { padding-bottom: 10px; }
@media (max-width: 560px) {
  .info { left: calc(10px + env(safe-area-inset-left, 0px)); right: auto; width: min(300px, calc(100% - 80px));
    bottom: calc(78px + env(safe-area-inset-bottom, 0px)); max-height: 52%; }
  .brand { left: calc(10px + env(safe-area-inset-left, 0px)); }
  .crumb { left: auto; right: calc(10px + env(safe-area-inset-right, 0px)); top: calc(14px + env(safe-area-inset-top, 0px)); max-width: 46%; overflow-x: auto; white-space: nowrap; }
  .map-controls { display: flex; position: absolute; z-index: 3; right: calc(10px + env(safe-area-inset-right, 0px)); top: 50%; transform: translateY(-50%); flex-direction: column; align-items: center; gap: 6px; }
  .map-controls .compass, .map-controls .tools { position: relative; inset: auto; }
  .map-controls .compass { width: 44px; height: 44px; justify-content: center; padding: 3px; }
  .map-controls .compass svg { width: 32px; height: 32px; }
  .map-controls .tools { flex-direction: column; gap: 2px; padding: 10px 4px; }
  .map-controls .tools .sep { width: 22px; height: 1px; margin: 2px 0; }
  .map-controls .tools button { min-width: 34px; }
  .foot { left: calc(10px + env(safe-area-inset-left, 0px)); right: calc(10px + env(safe-area-inset-right, 0px)); bottom: calc(8px + env(safe-area-inset-bottom, 0px)); }
}
@media (max-width: 1024px), (max-width: 1366px) and (pointer: coarse) {
  .info { width: min(300px, calc(100% - 80px)); max-height: 52%; }
  .map:not(.in-city) .info, .info.bubble-closed { display: none; }
  .info .info-head, .info .panel, .info .hint { display: none; }
  .info .mobile-bubble { display: flex; align-items: flex-start; gap: 8px; padding: 12px; }
  .bubble-copy { min-width: 0; flex: 1; }
  .bubble-copy strong { display: block; font-size: 15px; line-height: 1.35; }
  .bubble-copy p { margin: 4px 0 0; color: var(--ui-soft); font-size: 13px; line-height: 1.45; overflow-wrap: anywhere; }
  .bubble-open, .bubble-close { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--ui-ink); border-radius: 8px; cursor: pointer; }
  .bubble-open { color: #171614; background: var(--coral); }
  .bubble-open .ext { width: 16px; height: 16px; }
  .bubble-close { color: var(--ui-ink); background: var(--ui-card); font: inherit; font-size: 20px; line-height: 1; }
  .bubble-open:hover, .bubble-close:hover { filter: brightness(1.05); }
}

@media (min-width: 561px) and (max-width: 760px) { .info { bottom: calc(80px + env(safe-area-inset-bottom, 0px)); } }

.loader { position: absolute; inset: 0; z-index: 5; display: grid; place-content: center; justify-items: center; gap: 10px;
  background: var(--ui-card); transition: opacity .6s .2s, visibility 0s .8s, background-color .8s; }
.loader.done { opacity: 0; visibility: hidden; }
.ld-paper { position: relative; width: 120px; height: 70px; perspective: 400px; margin-bottom: 8px; }
.ld-paper i { position: absolute; bottom: 0; width: 0; height: 0; border-left: 15px solid transparent; border-right: 15px solid transparent;
  border-bottom: 52px solid var(--slate); transform-origin: 50% 100%; animation: fold 2.2s cubic-bezier(.5, 0, .2, 1) infinite; }
.ld-paper i:nth-child(1) { left: 4px; border-bottom-color: var(--pine); border-bottom-width: 40px; }
.ld-paper i:nth-child(2) { left: 30px; border-bottom-color: var(--slate); border-bottom-width: 66px; border-left-width: 22px; border-right-width: 22px; animation-delay: .15s; }
.ld-paper i:nth-child(3) { left: 64px; border-bottom-color: var(--mustard); border-bottom-width: 46px; animation-delay: .3s; }
.ld-paper i:nth-child(4) { left: 90px; border-bottom-color: var(--olive); border-bottom-width: 34px; animation-delay: .45s; }
@keyframes fold { 0% { transform: rotateX(90deg); } 30%, 70% { transform: rotateX(0deg); } 100% { transform: rotateX(-90deg); } }
.ld-title { font-family: var(--font-map); font-style: italic; font-weight: 600; font-size: 26px; color: var(--ui-ink); }
.ld-step { font-family: var(--font-mono); font-size: 12px; color: var(--ui-faint); }
.ld-bar { width: 180px; height: 3px; background: var(--ui-line); border-radius: 2px; overflow: hidden; }
.ld-bar i { display: block; height: 100%; background: var(--coral); transform: scaleX(0); transform-origin: left; transition: transform .3s; }
@media (prefers-reduced-motion: reduce) { .ld-paper i { animation: none; } }
.fallback { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; text-align: center; color: var(--ui-soft); }

/* 3D labels */
.c-tag { pointer-events: auto; cursor: pointer; color: var(--ui-ink); background: var(--ui-card); border: 1px solid var(--ui-ink);
  border-radius: 8px; padding: 2px 10px 4px; white-space: nowrap; display: grid; justify-items: center; line-height: 1.15;
