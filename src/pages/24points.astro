---
import Base from '@/layouts/Base.astro'
import Points24 from '@/components/islands/Points24'
---

<Base title='24 Points Game'>
  <header class='animate-fade-in-up'>
    <h1 class='page-title'>24 Points Game</h1>
    <p class='page-subtitle'>
      Enter 4 numbers between <strong class='text-foreground'>1</strong>
      {' and '}
      <strong class='text-foreground'>13</strong>, then calculate.
      <br />
      <span class='text-sm'>Tips: 1 is A, 11 is J, 12 is Q, 13 is K.</span>
    </p>
  </header>

  <Points24 client:load />
</Base>
