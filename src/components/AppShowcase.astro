---
import apps from '@/data/apps.json'
---

<section id='apps' aria-labelledby='apps-heading' class='home-section'>
  <div class='section-heading'>
    <div>
      <h2 id='apps-heading'>Made for the everyday.</h2>
      <p>A cleaner Mac, a new word, a thought in another language.</p>
    </div>
    <span class='status-label'>
      <span aria-hidden='true'></span>Apps coming soon
    </span>
  </div>
  <ul class='app-grid'>
    {apps.map((app) => (
      <li>
        <a href={app.url} class='app-item'>
          <img
            src={app.icon}
            alt=''
            width={76}
            height={76}
            loading='lazy'
            decoding='async'
          />
          <p class='platform-label'>{app.platform}</p>
          <h3>{app.name}</h3>
          <p class='app-description'>{app.description}</p>
          <span class='app-link'>
            Meet {app.name}
            <svg
              width='16'
              height='16'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.7'
              aria-hidden='true'
            >
              <path d='M7 17 17 7M7 7h10v10' />
            </svg>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
