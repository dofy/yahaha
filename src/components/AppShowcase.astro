---
import apps from '@/data/apps.json'
---

<section id='apps' aria-labelledby='apps-heading' class='home-section'>
  <div class='section-heading'>
    <div>
      <h2 id='apps-heading'>Made for the everyday.</h2>
      <p>Clean up, learn, translate, create and explore.</p>
    </div>
    <span class='status-label'>
      <span aria-hidden='true'></span>Apps & web tools
    </span>
  </div>
  <ul class='app-grid'>
    {apps.map((app) => (
      <li>
        <a href={app.url} class='app-item'>
          <img
            src={app.icon}
            alt=''
            width={76}
            height={76}
            loading='lazy'
            decoding='async'
          />
          <p class='platform-label'>{app.platform}</p>
          <h3>{app.name}</h3>
          <p class='app-description'>{app.description}</p>
          <span class='app-link'>Meet {app.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
