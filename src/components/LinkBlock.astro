---
import type { LinkCategory, GitHubLink, SocialLink, NormalLink } from '@/types'

interface Props {
  cat: LinkCategory
  links: (NormalLink | SocialLink | GitHubLink)[]
}

const { cat, links } = Astro.props

const catLabels: Record<string, string> = {
  social: 'social',
  heart: 'dharma',
  github: 'projects',
  tool: 'tools',
}
// Adventure-prop icon per section — ligne-claire decoration, not real chars.
const catIcons: Record<string, string> = {
  social: '🧭', // compass
  heart: '🕯️', // candle
  github: '🗺️', // map
  tool: '🔍', // magnifier
}
const label = catLabels[cat.name] ?? cat.name
const icon = catIcons[cat.name] ?? '✦'

// shields.io renders remotely, so these have to be literal hex — they cannot
// read the CSS tokens. Tuned to mint-deep / ink.
const badgeColor = '2f7d78'
const badgeLabelColor = '2b3243'
---

<section class="glass rounded-blob mt-10 px-5 py-5 sm:px-6 sm:py-6" data-reveal>
  <h2 class="section-label mb-4 flex items-center gap-2">
    <span aria-hidden="true" class="text-base">{icon}</span>
    {label}
  </h2>

  {
    cat.name === 'github' ? (
      <ul class="grid gap-x-8 gap-y-3 text-[15px] sm:grid-cols-2">
        {(links as GitHubLink[]).map((g) => (
          <li class="flex items-center justify-between gap-3">
            <a
              href={`https://github.com/dofy/${g.url}`}
              class="group link truncate"
            >
              <span class="link-label">{g.name}</span>
            </a>
            <img
              width={g.width}
              height={20}
              alt={`${g.name} stars`}
              loading="lazy"
              class="shrink-0 opacity-90"
              src={`https://img.shields.io/github/stars/dofy/${g.url}?style=flat&color=${badgeColor}&labelColor=${badgeLabelColor}`}
            />
          </li>
        ))}
      </ul>
    ) : (
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-[15px]">
        {links.map((link) => {
          if (cat.name === 'social') {
            const s = link as SocialLink
            const host = new URL(s.url).hostname
            return (
              <li>
                <a
                  href={`${s.url}${s.userId}`}
                  class="group link inline-flex items-center gap-1.5"
                >
                  <img
                    width={16}
                    height={16}
                    alt=""
                    loading="lazy"
                    class="size-4"
                    src={`https://www.google.com/s2/favicons?domain=${host}&sz=64`}
                  />
                  <span class="link-label">{s.name}</span>
                </a>
              </li>
            )
          }
          const n = link as NormalLink
          return (
            <li>
              <a href={n.url} class="group link inline-flex items-center gap-1.5">
                {n.icon && <span aria-hidden="true">{n.icon}</span>}
                <span class="link-label">{n.name}</span>
              </a>
            </li>
          )
        })}
      </ul>
    )
  }
</section>
