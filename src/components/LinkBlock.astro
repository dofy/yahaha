---
import type { LinkCategory, GitHubLink, SocialLink, NormalLink } from '@/types'

interface Props {
  cat: LinkCategory
  links: (NormalLink | SocialLink | GitHubLink)[]
}
const { cat, links } = Astro.props
const sections: Record<
  string,
  { id: string; title: string; description: string }
> = {
  tool: {
    id: 'tools',
    title: 'A small toolbox.',
    description: 'For a quick answer, a curious moment, or just a little fun.'
  },
  github: {
    id: 'projects',
    title: 'Out in the open.',
    description: 'Configs, experiments, and things you can make your own.'
  },
  social: {
    id: 'social',
    title: 'Around the web.',
    description: 'Find me elsewhere.'
  },
  heart: {
    id: 'dharma',
    title: 'A moment of quiet.',
    description: 'The Heart Sutra, in four languages.'
  }
}
const section = sections[cat.name] ?? {
  id: cat.name,
  title: cat.name,
  description: ''
}
const toolDescriptions: Record<string, string> = {
  '/24points': 'Four numbers. Find a way to 24.',
  '/tarot': 'Explore the 22 major arcana.',
  '/emoji': 'Find an emoji in your own words.',
  '/emoticon': 'A little expression, ready to copy.',
  '/morse': 'Turn words into dots and dashes.',
  '/ascii-art': 'Turn text into ASCII art.',
  'https://sync-text.phpz.org/': 'Send a snippet between devices.'
}
---

<section
  id={section.id}
  class:list={[
    'home-section',
    {
      'compact-section': ['social', 'heart'].includes(cat.name),
      'toolbox-section': cat.name === 'tool'
    }
  ]}
  aria-labelledby={`${section.id}-heading`}
>
  <div class='section-heading'>
    <div>
      <h2 id={`${section.id}-heading`}>{section.title}</h2>
      <p>{section.description}</p>
    </div>
  </div>
  {cat.name === 'github' ? (
    <ul class='project-grid'>
      {(links as GitHubLink[]).map((g) => (
        <li>
          <a href={`https://github.com/dofy/${g.url}`} class='project-link'>
            <span class='project-icon' aria-hidden='true'>
              <svg
                width='19'
                height='19'
                viewBox='0 0 24 24'
                fill='currentColor'
              >
                <path d='M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.16a10.76 10.76 0 0 1 5.63 0c2.15-1.46 3.1-1.16 3.1-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.64 5.27-5.15 5.55.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.77.54A11.25 11.25 0 0 0 12 .75Z' />
              </svg>
            </span>
            <span class='project-name'>{g.name}</span>
            <img
              width={g.width}
              height={20}
              alt={`${g.name} stars`}
              loading='lazy'
              src={`https://img.shields.io/github/stars/dofy/${g.url}?style=flat&color=b83d30&labelColor=69463f`}
            />
          </a>
        </li>
      ))}
    </ul>
  ) : cat.name === 'tool' ? (
    <ul class='tool-grid'>
      {(links as NormalLink[]).map((link) => (
        <li>
          <a href={link.url} class='tool-item'>
            <span class='tool-icon' aria-hidden='true'>
              {link.icon}
            </span>
            <div class='tool-copy'>
              <h3>{link.name}</h3>
              <p>{toolDescriptions[link.url]}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <ul class='text-links'>
      {links.map((link) => {
        if (cat.name === 'social') {
          const s = link as SocialLink
          return (
            <li>
              <a href={`${s.url}${s.userId}`} class='personal-link social-link'>
                <img
                  src={s.favicon}
                  width='16'
                  height='16'
                  alt=''
                  aria-hidden='true'
                  loading='lazy'
                  decoding='async'
                />
                <span>{s.name}</span>
              </a>
            </li>
          )
        }
        const n = link as NormalLink
        return (
          <li>
            <a href={n.url} class='personal-link quiet-link'>
              {n.name}
            </a>
          </li>
        )
      })}
    </ul>
  )}
</section>
