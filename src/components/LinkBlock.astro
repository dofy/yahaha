---
import type { LinkCategory, GitHubLink, SocialLink, NormalLink } from '@/types'

interface Props {
  cat: LinkCategory
  links: (NormalLink | SocialLink | GitHubLink)[]
}
const { cat, links } = Astro.props
const sections: Record<
  string,
  { id: string; title: string; description: string }
> = {
  tool: {
    id: 'tools',
    title: 'A small toolbox.',
    description: 'For a quick answer, a curious moment, or just a little fun.'
  },
  github: {
    id: 'projects',
    title: 'Out in the open.',
    description: 'Configs, experiments, and things you can make your own.'
  },
  social: {
    id: 'social',
    title: 'Around the web.',
    description: 'Find me elsewhere.'
  },
  heart: {
    id: 'dharma',
    title: 'A moment of quiet.',
    description: 'The Heart Sutra, in four languages.'
  }
}
const section = sections[cat.name] ?? {
  id: cat.name,
  title: cat.name,
  description: ''
}
const toolDescriptions: Record<string, string> = {
  '/24points': 'Four numbers. Find a way to 24.',
  '/tarot': 'Explore the 22 major arcana.',
  '/emoji': 'Find an emoji in your own words.',
  '/emoticon': 'A little expression, ready to copy.',
  '/morse': 'Turn words into dots and dashes.',
  'https://sync-text.phpz.org/': 'Send a snippet between devices.'
}
---

<section
  id={section.id}
  class:list={[
    'home-section',
    { 'compact-section': ['social', 'heart'].includes(cat.name) }
  ]}
  aria-labelledby={`${section.id}-heading`}
>
  <div class='section-heading'>
    <div>
      <h2 id={`${section.id}-heading`}>{section.title}</h2>
      <p>{section.description}</p>
    </div>
  </div>
  {cat.name === 'github' ? (
    <ul class='project-grid'>
      {(links as GitHubLink[]).map((g) => (
        <li>
          <a href={`https://github.com/dofy/${g.url}`} class='project-link'>
            <span>{g.name}</span>
            <svg
              width='16'
              height='16'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.7'
              aria-hidden='true'
            >
              <path d='M7 17 17 7M7 7h10v10' />
            </svg>
          </a>
          <img
            width={g.width}
            height={20}
            alt={`${g.name} stars`}
            loading='lazy'
            src={`https://img.shields.io/github/stars/dofy/${g.url}?style=flat&color=eaf1f4&labelColor=52717a`}
          />
        </li>
      ))}
    </ul>
  ) : cat.name === 'tool' ? (
    <ul class='tool-grid'>
      {(links as NormalLink[]).map((link) => (
        <li>
          <a href={link.url} class='tool-item'>
            <span class='tool-icon' aria-hidden='true'>
              {link.icon}
            </span>
            <div>
              <h3>{link.name}</h3>
              <p>{toolDescriptions[link.url]}</p>
            </div>
            <svg
              width='18'
              height='18'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.7'
              aria-hidden='true'
            >
              <path d='m9 5 7 7-7 7' />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <ul class='text-links'>
      {links.map((link) => {
        if (cat.name === 'social') {
          const s = link as SocialLink
          return (
            <li>
              <a
                href={`${s.url}${s.userId}`}
                class='link link-label social-link'
              >
                <img
                  src={s.favicon}
                  width='16'
                  height='16'
                  alt=''
                  aria-hidden='true'
                  loading='lazy'
                  decoding='async'
                />
                <span>{s.name}</span>
              </a>
            </li>
          )
        }
        const n = link as NormalLink
        return (
          <li>
            <a href={n.url} class='link link-label'>
              {n.name}
            </a>
          </li>
        )
      })}
    </ul>
  )}
</section>
