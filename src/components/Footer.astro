---
import domains from '@/data/domains.json'
import SiteBrand from '@/components/SiteBrand.astro'

const begin = 2007
const year = new Date().getFullYear()
---

<footer class='site-footer'>
  <SiteBrand />
  <nav class='footer-links' aria-label='Sites' data-domains>
    {domains.map(({ name, url }) => (
      <a href={url} data-domain={name.toLowerCase()}>
        {name}
      </a>
    ))}
  </nav>
  <p class='copyright'>
    &copy; {begin}&ndash;{year} Seven
  </p>
  <slot />
</footer>
