---
import domains from '@/data/domains.json'

const begin = 2007
const year = new Date().getFullYear()
---

<!-- The one opaque, hard-coloured panel on the site. Reversed text on a
     translucent pane reads muddy, so the page's bottom anchor is solid
     mint-deep rather than glass. -->
<footer
  class='bg-mint-deep rounded-blob mt-16 flex flex-col items-center gap-3 px-5 py-8 text-center text-sm text-white shadow-sm'
  data-reveal
>
  <div class='font-pixel text-[9px] tracking-wider uppercase opacity-80'>
    copyright &copy; {begin}&ndash;{year}
  </div>
  <nav
    class='flex flex-wrap items-center justify-center gap-x-4 gap-y-1'
    data-domains
  >
    {domains.map(({ name, url }) => (
      <a
        href={url}
        class='tx text-white/90 underline decoration-white/30 decoration-2 underline-offset-4 hover:text-white hover:decoration-white'
        data-domain={name.toLowerCase()}
      >
        {name}
      </a>
    ))}
  </nav>
  <slot />
</footer>

<script>
  // Bold the domain matching the current host (static-safe, runs client-side).
  const host = window.location.hostname.toLowerCase()
  document
    .querySelectorAll<HTMLAnchorElement>('[data-domain]')
    .forEach((el) => {
      if (el.dataset.domain === host) {
        el.classList.add('font-bold', 'text-white', 'decoration-white')
      }
    })
</script>
